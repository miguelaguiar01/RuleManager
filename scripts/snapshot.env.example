# Copy to scripts/snapshot.env (gitignored) and fill in real values.
# Used by scripts/snapshot.sh, which switches AND verifies the kube context
# before each phase (dump on the source cluster, restore on the local one).

# --- Kube contexts (must be different; the drop only ever runs on RESTORE) --
DUMP_CONTEXT=REPLACE_ME_source_context        # e.g. the OpenShift context for the dev cluster
RESTORE_CONTEXT=k3d-mdm-local-k8s             # the local k3d cluster

# --- Source: a pod (in DUMP_CONTEXT) that can reach the DB, + the DB itself --
SRC_NS=REPLACE_ME_namespace                   # e.g. mdm-dev
POD=REPLACE_ME_pod                            # e.g. mdm-airflow-worker-0
SRC_HOST=REPLACE_ME_db_host
SRC_PORT=5432
SRC_DB=REPLACE_ME_dbname
SRC_USER=REPLACE_ME_user
SRC_SCHEMA=REPLACE_ME_schema                  # leave empty ("") to dump the WHOLE database

# --- Local target: the postgres pod in RESTORE_CONTEXT ----------------------
LOCAL_NS=REPLACE_ME_local_namespace
LOCAL_POD=                                    # explicit pod name, OR set LOCAL_SELECTOR:
LOCAL_SELECTOR=REPLACE_ME_selector            # e.g. app.kubernetes.io/name=postgresql
LOCAL_SUPERUSER=postgres
TARGET_DB=                                    # defaults to SRC_DB
JOBS=4

# Local superuser password (the k3d Postgres needs one). Pick ONE:
# (a) set it directly (gitignored file):
LOCAL_PGPASSWORD=REPLACE_ME
# (b) or fetch from the local cluster secret at runtime:
# LOCAL_SECRET=REPLACE_ME_local_secret        # e.g. mdm-ca-postgresql
# LOCAL_SECRET_KEY=postgres-password
# LOCAL_SECRET_NS=REPLACE_ME                   # defaults to LOCAL_NS

# --- Password: pick ONE -----------------------------------------------------
# (a) fetch from the source-cluster secret at runtime (nothing stored):
SECRET=REPLACE_ME_secret
SECRET_KEY=password                           # list keys with:
#   kubectl --context <DUMP_CONTEXT> -n <SRC_NS> get secret <SECRET> \
#     -o go-template='{{range $k,$v := .data}}{{$k}}{{"\n"}}{{end}}'
# SECRET_NS=REPLACE_ME                         # defaults to SRC_NS
#
# (b) or set it directly (this file is gitignored):
# PGPASSWORD=REPLACE_ME
