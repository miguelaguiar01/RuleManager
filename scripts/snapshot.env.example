# Copy to scripts/snapshot.env (gitignored) and fill in real values.
# Used by scripts/snapshot.sh.

# --- Where to run pg_dump (a pod that can reach the DB) ---------------------
NAMESPACE=REPLACE_ME_namespace          # e.g. mdm-dev
POD=REPLACE_ME_pod                      # a running pod with a route to the DB

# --- The source database (only reachable from inside the cluster) ----------
SRC_HOST=REPLACE_ME_db_host             # e.g. the db hostname
SRC_PORT=5432
SRC_DB=REPLACE_ME_dbname
SRC_USER=REPLACE_ME_user
SRC_SCHEMA=REPLACE_ME_schema            # leave empty ("") to dump the WHOLE database

# --- Local Docker Postgres to restore into (must be >= source major ver) ---
LOCAL_CONTAINER=REPLACE_ME_container    # `docker ps` name of your local postgres
LOCAL_SUPERUSER=postgres
TARGET_DB=                              # defaults to SRC_DB
JOBS=4                                  # parallel restore workers

# --- Password: pick ONE -----------------------------------------------------
# (a) fetch from the cluster secret at runtime (nothing stored):
SECRET=REPLACE_ME_secret
SECRET_KEY=password                     # list keys with:
#   oc get secret <SECRET> -n <NS> -o go-template='{{range $k,$v := .data}}{{$k}}{{"\n"}}{{end}}'
# SECRET_NS=REPLACE_ME                  # defaults to NAMESPACE
#
# (b) or set it directly (this file is gitignored):
# PGPASSWORD=REPLACE_ME
